{
  "kind": "collectionType",
  "collectionName": "carts",
  "info": {
    "singularName": "cart",
    "pluralName": "carts",
    "displayName": "Cart",
    "description": "User carts"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "carts"
    },
    "degree": {
      "type": "enumeration",
      "default": "active",
      "enum": [
        "active",
        "ordered",
        "abandoned"
      ]
    },
    "items": {
      "type": "component",
      "component": "cart.cart-cart-item",
      "repeatable": true
    }
  }
}
